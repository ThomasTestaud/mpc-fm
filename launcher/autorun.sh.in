#!/bin/sh
# mpc-fm @VERSION@ launcher for the Akai MPC Sample.
#
# The stock script runner starts this file (it checks autorun.check, made
# from autorun.json and this file). We start SampQOL OS from its unchanged
# official folder, inside this one, and add our fm.so to the app process:
#
#   this autorun.sh -> SampQOL's autorun.sh -> qol-run.sh -> "setarch" (our
#   stand-in, first in PATH) -> real setarch -> "MPC Sample" with
#   LD_PRELOAD="/tmp/mpcqol.so /run/mpcfm/fm.so"
#
# The stand-in also writes a status line over SampQOL's splash.
# If our files are wrong or missing: SampQOL OS starts without FM.
# If SampQOL OS is missing: nothing starts, the MPC stays stock.
# To turn FM off: create the file mpcfm/DISABLE (any content).

DIR="$(cd "$(dirname "$0")" && pwd)"
RUN="${MPCFM_RUN:-/run/mpcfm}"

log() {
    mkdir -p "$DIR/logs"
    echo "$(date '+%F %T') autorun: $*" >> "$DIR/logs/mpcfm-launch.log"
} 2>/dev/null

# SHA256 of our files, written at build time. autorun.check covers this
# script, so the stock runner also protects these pins.
PINS="@PINS@"

pin_ok() {
    line=$(echo "$PINS" | grep "  $1\$") || return 1
    (cd "$DIR/mpcfm" 2>/dev/null && echo "$line" | sha256sum -c >/dev/null 2>&1)
}

# SampQOL's official "autorun" folder, copied into this one: as "sampqol",
# as "autorun", or inside the unzipped release folder.
find_qol() {
    for d in "$DIR/sampqol" "$DIR/autorun" "$DIR"/*/ "$DIR"/*/autorun/; do
        d="${d%/}"
        if [ -f "$d/autorun.sh" ] && [ -f "$d/qol-run.sh" ] && [ -f "$d/mpcqol.so" ]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

if ! QOL=$(find_qol); then
    log "no SampQOL OS folder in $DIR: copy the \"autorun\" folder of SampQOL OS into it. The MPC stays stock."
    exit 0
fi

# Our setarch stand-in is the only way in. Without it, FM is off and no
# status line is shown.
SHIM=0
pin_ok setarch && SHIM=1
OFF=
if [ -e "$DIR/mpcfm/DISABLE" ]; then
    OFF="disabled"
elif [ "$SHIM" = 0 ] || ! pin_ok fm.so; then
    OFF="files changed"
fi

# Copy to RAM: the SD card is mounted noexec, and the app must keep working
# if the card goes away. Copy, then rename: a running app keeps its old file.
copy() { # src dst mode
    cp "$1" "$2.new" 2>/dev/null && chmod "$3" "$2.new" && mv -f "$2.new" "$2"
}
if [ "$SHIM" = 1 ]; then
    mkdir -p "$RUN/bin" 2>/dev/null && copy "$DIR/mpcfm/setarch" "$RUN/bin/setarch" 755 ||
        { SHIM=0; OFF="${OFF:-copy failed}"; }
fi
if [ "$SHIM" = 1 ] && [ -z "$OFF" ]; then
    copy "$DIR/mpcfm/fm.so" "$RUN/fm.so" 644 || OFF="copy failed"
fi

if [ "$SHIM" = 1 ]; then
    MPCFM_BIN="$RUN/bin"
    MPCFM_STATE="$RUN"
    MPCFM_LOGDIR="$DIR/logs"
    PATH="$RUN/bin:$PATH"
    export MPCFM_BIN MPCFM_STATE MPCFM_LOGDIR PATH
    if [ -z "$OFF" ]; then
        MPCFM_SO="$RUN/fm.so"
        export MPCFM_SO
    else
        MPCFM_OFF="$OFF"
        export MPCFM_OFF
    fi
fi

if [ -z "$OFF" ]; then
    log "mpc-fm @VERSION@: start SampQOL OS ($QOL) with FM"
else
    log "mpc-fm @VERSION@: start SampQOL OS ($QOL) without FM: $OFF"
fi
exec sh "$QOL/autorun.sh"
